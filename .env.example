# 复制本文件为 .env 后填写真实密钥
# cp .env.example .env
# 注意：键名只能用字母数字下划线，不要用空格/括号；一行一个 KEY=value

# 火山引擎 · 豆包端到端实时语音
VOLC_APP_ID=
VOLC_ACCESS_KEY=

# 阿里云 · ASR（可选）
ALIYUN_ASR_API_KEY=
ALIYUN_ASR_BASE_URL=
ALIYUN_ASR_MODELS=Qwen3-ASR-Flash,Fun-ASR语音识别

# LLM（挂机拜访小记抽取；OpenAI 兼容 Chat Completions）
# 三者齐全时走 LLM；缺任一则回退规则抽取
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
